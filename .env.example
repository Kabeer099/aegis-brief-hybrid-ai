# Firebase Web App Configuration (Free Spark tier — Gemini Developer API requires NO billing!)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase App Check (Required for #BuildHybridAI 2026)
# For production, provide your reCAPTCHA Enterprise site key:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local testing / hackathon judging, set "true" (auto-generates debug UUID in console)
# or paste a pre-registered App Check debug token UUID:
VITE_APP_CHECK_DEBUG_TOKEN=true

# Default Cloud Model (overridden dynamically by Firebase Remote Config parameter `aegis_cloud_model`)
# Free-tier supported Firebase AI Logic models: gemini-4-hydrogen | gemini-3.8-flash | gemini-3.5-flash-lite
VITE_DEFAULT_CLOUD_MODEL=gemini-4-hydrogen
